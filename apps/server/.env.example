# DeviceLab control server — local development. Copy to .env and adjust.
# Never commit real secrets; production values come from infra/.env (see infra/.env.example).
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgresql://devicelab:devicelab@localhost:5432/devicelab?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_STREAM_SECRET=dev-only-stream-secret-change-me-0123456789abcdef

# s3 (MinIO) or fs (local directory, handy without Docker)
STORAGE_DRIVER=fs
STORAGE_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=devicelab
S3_ACCESS_KEY=devicelab
S3_SECRET_KEY=devicelab-minio-secret

# Login attempts per minute per IP (production: 10). Raised for local E2E runs from one IP.
AUTH_LOGIN_LIMIT_PER_MIN=60

RESERVATION_DEFAULT_MIN=30
RESERVATION_MAX_MIN=120
IDLE_WARN_MIN=5
IDLE_RELEASE_MIN=10
CLEANUP_KEEP_PACKAGES=
CLEANUP_REBOOT=false

# Seed (pnpm db:seed)
SEED_ADMIN_EMAIL=admin@devicelab.local
SEED_ADMIN_PASSWORD=Admin@DeviceLab1
SEED_DEMO=true
# Registers host "mock-host-01" so `pnpm dev:mock-agent` connects out of the box.
SEED_MOCK_HOST_TOKEN=dlh_dev_mock_host_token_change_me_000000
