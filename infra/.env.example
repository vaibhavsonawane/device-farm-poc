# DeviceLab production settings for infra/docker-compose.yml. Copy to infra/.env.
# Generate secrets with: openssl rand -base64 48
DEVICELAB_HOSTNAME=devicelab.bank.local
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-to-48-random-bytes-base64-xxxxxxxxxxxxxxxx
JWT_STREAM_SECRET=change-me-to-48-random-bytes-base64-yyyyyyyyyyyyyyyy

# Object storage. With MinIO: run compose with `--profile minio`.
# Without it: STORAGE_DRIVER=fs keeps files in the server volume.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=devicelab
S3_ACCESS_KEY=devicelab
S3_SECRET_KEY=change-me-min-8-chars
# MINIO_IMAGE=registry.bank.local/mirror/minio:RELEASE.2025-04-22T22-12-26Z

UPLOAD_MAX_MB=500
RESERVATION_DEFAULT_MIN=30
RESERVATION_MAX_MIN=120
IDLE_WARN_MIN=5
IDLE_RELEASE_MIN=10
CLEANUP_KEEP_PACKAGES=
CLEANUP_REBOOT=false

# First admin (seed). Leave the password empty to have one generated and printed once.
SEED_ADMIN_EMAIL=admin@devicelab.bank.local
SEED_ADMIN_PASSWORD=
