{
  "name": "devicelab",
  "private": true,
  "description": "DeviceLab \u2014 on-prem remote mobile device lab. Crafted by Vaibhav Sonawane through Claude",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter=@devicelab/server --filter=@devicelab/portal",
    "dev:mock-agent": "pnpm --filter @devicelab/host-agent dev:mock",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @devicelab/portal test:e2e",
    "db:migrate": "pnpm --filter @devicelab/server prisma:migrate",
    "db:seed": "pnpm --filter @devicelab/server prisma:seed",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "~5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild",
      "@nestjs/core",
      "@swc/core"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}
